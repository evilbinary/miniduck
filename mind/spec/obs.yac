-- =====================================================================
-- mind/spec/obs.yac — 观测向量「单一来源」定义
--
-- 约束（本目录所有 .yac 文件共同遵守）：
--   * 只使用 `let` 绑定与标量 / 列表字面量，禁止 IO、禁止副作用；
--   * yac 侧（真机）可直接执行本文件构建观测；
--   * Python 侧（训练）以「受限子集」方式解析本文件，不执行任何代码。
-- 这样一处定义、两端消费，消除 sim2real 的观测构建漂移。
--
-- 顺序即拼接顺序：obs[0..] 依次为下列各段。
-- 腿关节段（joint_pos / joint_vel / last_action）的维度与顺序由
-- body/robot.yaml 的 policy.leg_joints 决定（L: 14，S: 6）。
-- =====================================================================

-- 维度公式（N = 策略控制的腿关节数）
let obs_dim_formula = "3+3+3+N+N+N+2+2+1+3+2" in
let obs_dim_L = 61 in          -- N = 14
let obs_dim_S = 37 in          -- N = 6

-- 段表：[名称, 维度(int 或 "N"), 来源, 说明]
let obs_segments = [
  ["base_ang_vel",       3,   "imu.ang_vel",       "IMU 陀螺仪，rad/s"],
  ["projected_gravity",  3,   "imu.gravity_vec",   "重力向量在机体坐标系"],
  ["command",            3,   "mindd.cmd",         "vx, vy, yaw_rate；缓存为空 → 零速命令"],
  ["joint_pos",          "N", "servo.pos",         "腿关节当前位置，rad；顺序 = policy.leg_joints"],
  ["joint_vel",          "N", "servo.vel",         "舵机速度或差分估计，rad/s"],
  ["last_action",        "N", "policy.prev_out",   "上一帧策略输出 [-1,1]"],
  ["contact",            2,   "tof_or_current",    "左右脚触地；无传感器则虚拟估计"],
  ["phase",              2,   "phase_recur",       "cos(2πt/T), sin(2πt/T)"],
  ["base_height",        1,   "estimator",         "躯干离地高度估计，m"],
  ["imu_euler",          3,   "imu.euler",         "roll, pitch, yaw（状态对齐用）"],
  ["base_lin_vel",       2,   "observer_or_zero",  "vx, vy；不可靠时置 0"]
] in

-- 缺失与噪声策略（与训练侧、域随机化必须一致）
let obs_missing = [
  ["base_lin_vel", "zero_when_unreliable", "训练时同样置 0 + 随机 dropout"],
  ["contact",      "virtual_estimate",     "无 ToF 时由电流/运动学估计"],
  ["command",      "zero_command",         "mindd 缓存为空时用零速，而非上次命令"]
] in

-- 观测处理的顺序约定（真机与训练必须逐位一致）
let obs_pipeline = [
  "1_raw_assemble",       -- 按 obs_segments 顺序拼接原始值
  "2_delay_and_noise",    -- 域随机化：延迟 obs_delay_frames + 加噪
  "3_dropout",            -- base_lin_vel 按概率置 0
  "4_handover"            -- 交给 runtime（归一化已在 blob 内烘焙）
] in

-- 顶层尾表达式：保持纯表达式语义，无副作用
()
